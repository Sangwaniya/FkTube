{
  "manifest_version": 3,
  "name": "kya karne aaya hai bsdk, kaam karle na",
  "version": "2.0.0",
  "description": "YouTube ko task-list & planner me badal do, adult sites block karo. Kaam pehle, timepass baad me.",
  "permissions": ["storage", "declarativeNetRequest", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "kya karne aaya hai bsdk, kaam karle na",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": ["i18n.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["block.html", "i18n.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
